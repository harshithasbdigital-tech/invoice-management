PORT=5000
NODE_ENV=development

# ===================================================================
# HOSTINGER MySQL DATABASE CONFIGURATION
# ===================================================================
# In Hostinger hPanel -> Databases -> MySQL Databases:
# 1. DB_HOST: Hostinger MySQL host/IP (e.g., srvXXX.hstgr.io or your Hostinger IP. If hosted directly on Hostinger server, use localhost)
# 2. DB_PORT: 3306 (Standard MySQL port)
# 3. DB_NAME: MySQL Database Name (usually formatted like u123456789_invoices)
# 4. DB_USER: MySQL Username (usually formatted like u123456789_user)
# 5. DB_PASSWORD: Password set when creating the database user
# 6. DB_SSL: Set to false (or true if SSL required)
#
# NOTE: If connecting from outside Hostinger (e.g. local computer or external server),
# make sure to enable "Remote MySQL" in Hostinger hPanel for your IP (or % for any IP).
# ===================================================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=u412886035_sbvuser
DB_PASSWORD=Sbinvoice26
DB_NAME=u412886035_sbvdb
DB_SSL=false

# CORS Allowed Origin (Frontend Vite app)
CORS_ORIGIN=http://localhost:5173
